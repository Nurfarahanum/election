# Copy to .env. Replace empty values with private credentials before starting.
# Use openssl rand -hex 32 for SESSION_SECRET and a separate random hex string
# for POSTGRES_PASSWORD (its value is interpolated into the database URL).
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_DEMO=true

# Local HTTPS uses Caddy's internal CA. For public HTTPS use the public hostname
# in CADDY_SITE (example: vote.example.org), and set the matching HTTPS origin.
CADDY_SITE=localhost
APP_ORIGIN=https://localhost
