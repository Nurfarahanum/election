  header Strict-Transport-Security "max-age=31536000"
  request_body /admin/session {
    max_size 16KB
  }
  request_body /admin/manage {
    max_size 6MB
  }
  request_body /vote/login {
    max_size 16KB
  }
  request_body /vote/submit {
    max_size 128KB
  }
  request_body /admin/distribute {
    max_size 16KB
  }
  request_body /admin/account/password {
    max_size 16KB
  }
  reverse_proxy app:3000 {
    header_up X-Kopetro-Client-IP {remote_host}
  }
}
